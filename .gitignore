# Virtual environment
.venv/

# Python caches
__pycache__/
*.py[cod]

# Model checkpoints
*.pt
*.pth

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Chess engines (downloaded binaries, official Stockfish release unzipped into engines/)
engines/

# Games of the last evaluate_elo.py match
match.pgn

# Lichess elite database, 27 GB of pgns (database.nikonoel.fr). Only Carlsen.pgn is small enough for git
artifacts/pgn_data/lichess_elite/

# Output of preprocess.py, about 180 GB of arrays
processed_data/

# TensorBoard logs, one folder per training run
runs/

# Generated by tools/compare_runs.py
artifacts/progress.html

# Downloaded Fishtest game archives
artifacts/pgn_data/fishtest/*.pgn.gz

# OTB games (lumbras), 855 MB, and any other pgn collections: only Carlsen.pgn is small enough for git
artifacts/pgn_data/lumbras_otb_elite/
artifacts/pgn_data/*.7z

# Lichess puzzle database, 1.1 GB, downloaded by tools/puzzles.py when missing (database.lichess.org)
artifacts/puzzles/lichess_db_puzzle.csv
